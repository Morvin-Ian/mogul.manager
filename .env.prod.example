# ─────────────────────────────────────────────────────────────────────
# mogul.manager — production (.env.prod)
#
# Copy to .env.prod and fill in. Always load it explicitly, because compose
# interpolation (${POSTGRES_USER} in docker-compose.prod.yml) reads the
# --env-file, not the `env_file:` key:
#
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# Generate each secret separately:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────
# Host is the container name. Note this is mogul-db on port 5432 *inside*
# the compose network — the 5433 in docker-compose.prod.yml is only the
# loopback binding on the VPS, so KFL's postgres on 5432 stays untouched.
POSTGRES_USER=mogul
POSTGRES_PASSWORD=change-me-openssl-rand-hex-32
POSTGRES_DB=mogul_manager
DATABASE_URL=postgresql+psycopg://mogul:change-me-openssl-rand-hex-32@mogul-db:5432/mogul_manager

# ── Auth ─────────────────────────────────────────────────────────────
# Two DIFFERENT values. Rotating SECRET_KEY invalidates access tokens;
# rotating REFRESH_SECRET_KEY logs everyone out.
SECRET_KEY=change-me-openssl-rand-hex-32
REFRESH_SECRET_KEY=change-me-a-different-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
# Served over TLS by the shared nginx, so cookies must carry Secure.
COOKIE_SECURE=true

# ── Public URL ───────────────────────────────────────────────────────
# Drives the CORS allow-list and every emailed link. No trailing slash.
FRONTEND_URL=https://mogul.example.com

# ── Shared edge network ──────────────────────────────────────────────
# The external docker network KFL's nginx lives on, so it can proxy to
# mogul-web by name. Verify with: docker network ls
EDGE_NETWORK=kenyan-fantasy-league_fpl-vue

# ── DeepSeek (AI agent) ──────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Encrypts the provider API keys users save in Profile → AI Provider.
# Defaults to SECRET_KEY; set it separately so rotating SECRET_KEY
# does not make every stored key unreadable.
# AI_ENCRYPTION_KEY=

# ── S3-compatible storage (Cloudflare R2) ────────────────────────────
S3_ACCOUNT_ID=your-account-id
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET_NAME=mogul-manager-prod
S3_CUSTOM_DOMAIN=https://files.example.com
S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
# R2 only accepts auto/wnam/enam/weur/eeur/apac/oc — leave as auto.
S3_REGION_NAME=auto

# ── Email ────────────────────────────────────────────────────────────
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_USE_TLS=true

# ── Google OAuth (optional; leave blank to disable) ──────────────────
# The callback must match the Authorized redirect URI in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://mogul.example.com/api/auth/google/callback

# ── Tunables (defaults from config.py; uncomment to override) ────────
# MAX_UPLOAD_SIZE_BYTES=5242880   # keep client_max_body_size in nginx above this
# STUCK_THRESHOLD_SECONDS=900
# MAX_PROCESSING_ATTEMPTS=3
# DOCUMENT_CHECK_INTERVAL=1800
# MAX_TOOL_ITERATIONS=5
# WRITE_RATE_MAX=240
# WRITE_RATE_WINDOW=60.0
